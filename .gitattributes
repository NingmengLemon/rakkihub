# 统一使用 LF 换行
* text=auto eol=lf

# Baseline Profile 生成文件：标记为文本，统一使用 LF 换行，避免 CRLF 抖动
app/src/release/generated/baselineProfiles/*.txt text eol=lf

# 压缩后的生成资产：不参与 whitespace 检查
app/src/main/assets/html/mark.bundle.js -whitespace
app/src/main/assets/html/THIRD_PARTY_LICENSES.txt -whitespace

# Windows 批处理脚本按 CRLF 检出（索引内仍归一为 LF）
gradlew.bat text eol=crlf